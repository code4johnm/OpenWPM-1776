# Build context hygiene. Do not send crawl data, secrets, or host browser caches.

# Capture / operator data (must never bake into the image)
datadir
docker-volume
.tranco
*.sqlite
*.har
*.log

# VCS and editor
.git
.github
.idea
.vscode
.crosslink
.claude

# Local environments and caches
venv
.venv
ms-playwright
firefox-bin
Nightly*.app
Firefox*.app
node_modules
Extension
.pytest_cache
.mypy_cache
.coverage
htmlcov
**/__pycache__
*.pyc
*.egg-info

# Secrets
.env
.env.*
**/*.pem
**/*.key
secrets
credentials.json

# Tests and docs not required at runtime (bind-mount in dev if needed)
test
docs/_build
*.md
!README.md
!LICENSE
!MIGRATION.md
openwpm-1776-secure-baseline
deploy
compose.yaml
